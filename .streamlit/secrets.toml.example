# Copy to .streamlit/secrets.toml for local runs (gitignored — never commit
# the real file). On Streamlit Community Cloud, paste the same lines into your
# app's Settings -> Secrets instead: the local file is NOT deployed, so a key
# that works locally is simply absent up there until you add it by hand.

ANTHROPIC_API_KEY = "sk-ant-..."
APP_PASSWORD = "choose-something-your-partner-can-type"

# Optional. Without it the app still works; the polished-render button on a
# result shows "Set GEMINI_API_KEY in the app's secrets to enable this."
# instead. With it, each click costs about $0.04 against this key — on the
# hosted app that means anyone holding APP_PASSWORD can spend it.
GEMINI_API_KEY = "..."
